package mod5C;

import java.util.Scanner;


/* -----------------T2-MOD5-Ej26------------------*/
/*Realiza un programa que pida un número por teclado y que 
luego muestre ese número al revés.*/
/**
 *
 * @author Marta González
 */
public class Ej26 {
    public static void main(String[] args) {
    	
    	int num;
    	int copia;
    	int alreves=0;
    	
        Scanner sc = new Scanner(System.in);
        System.out.println("Introduce un numero: ");
        num = sc.nextInt();
        
        copia=num;
        
        while (num>0) {
			alreves= (alreves*10)+(num%10);
			copia/=10;
		}
        System.out.println(alreves);
        
    } //main
} //class
